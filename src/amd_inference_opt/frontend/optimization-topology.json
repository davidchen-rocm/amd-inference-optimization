{
  "schema": "gpuopt.optimization-topology-config.v1",
  "nodes": [
    {
      "id": "tensor-sensitivity",
      "title": "Tensor sensitivity",
      "layer": "MODEL",
      "availability": "IMPLEMENTED",
      "summary": "Collects per-tensor importance evidence before assigning precision.",
      "inputs": ["BF16 or compatible source model", "calibration corpus"],
      "outputs": ["SensitivityEvidence"],
      "tags": ["imatrix", "quality-ablation"]
    },
    {
      "id": "mixed-precision",
      "title": "Mixed precision Q4/Q5/Q6/Q8",
      "layer": "MODEL",
      "availability": "IMPLEMENTED",
      "summary": "Runs the bounded precision workflow and Pareto selection.",
      "inputs": ["tensor inventory", "sensitivity evidence", "precision policy"],
      "outputs": ["candidate assignments", "Pareto frontier"],
      "tags": ["effective-bpw", "packed-bytes"]
    },
    {
      "id": "precision-assignment",
      "title": "Tensor precision assignment",
      "layer": "MODEL",
      "availability": "IMPLEMENTED",
      "summary": "Creates an exact tensor-to-precision assignment with protected groups.",
      "inputs": ["TensorNamingConfig", "SensitivityEvidence"],
      "outputs": ["PrecisionPolicy"],
      "tags": ["config-driven"]
    },
    {
      "id": "weight-packing",
      "title": "Build and pack weights",
      "layer": "MODEL",
      "availability": "IMPLEMENTED",
      "summary": "Materializes llama.cpp quantization policies with hash-bound provenance.",
      "inputs": ["source GGUF", "imatrix", "PrecisionPolicy"],
      "outputs": ["packed GGUF", "effective bpw"],
      "tags": ["llama-quantize"]
    },
    {
      "id": "q4rdna-hybrid",
      "title": "Q4_RDNA hybrid routing",
      "layer": "MODEL",
      "availability": "PARTIAL",
      "summary": "Represents custom Q4_RDNA weights with sensitive tensor fallback.",
      "inputs": ["sidecar", "routing policy"],
      "outputs": ["hybrid representation"],
      "tags": ["Q4_RDNA", "QKV-fallback"]
    },
    {
      "id": "kv-cache-quantization",
      "title": "KV-cache quantization",
      "layer": "MODEL",
      "availability": "IMPLEMENTED",
      "summary": "Evaluates F16, Q8 and Q4 KV cache arms at configured context depths.",
      "inputs": ["selected model", "context-depth protocol"],
      "outputs": ["memory and decode comparison"],
      "tags": ["long-context", "Q8", "Q4"]
    },
    {
      "id": "weight-layout-fused-dequant",
      "title": "Weight layout + fused dequant",
      "layer": "KERNEL",
      "availability": "PARTIAL",
      "summary": "Tracks custom wave32-friendly layout and dequant-in-GEMV implementations.",
      "inputs": ["packed representation", "shape mapping"],
      "outputs": ["layout-specific kernel path"],
      "tags": ["wave32", "Q4_RDNA"]
    },
    {
      "id": "shape-specific-kernel",
      "title": "Shape-specific kernel",
      "layer": "KERNEL",
      "availability": "PARTIAL",
      "summary": "Scopes kernel changes to measured 12288x4096, 4096x4096, 1024x4096 or vocab shapes.",
      "inputs": ["InferenceExecutionMap", "kernel timing"],
      "outputs": ["exact-shape patch"],
      "tags": ["real-shape"]
    },
    {
      "id": "split-k",
      "title": "Split-K mapping",
      "layer": "KERNEL",
      "availability": "PARTIAL",
      "summary": "Changes execution mapping to increase wave supply for latency-bound GEMV shapes.",
      "inputs": ["shape", "wave supply evidence"],
      "outputs": ["split-K candidate"],
      "tags": ["wave32", "mapping"]
    },
    {
      "id": "tile-wave-autotune",
      "title": "Tile / Wave mapping autotune",
      "layer": "KERNEL",
      "availability": "PLANNED",
      "summary": "Knob schemas exist, but a general automatic search engine is not implemented.",
      "inputs": ["shape", "search bounds"],
      "outputs": ["mapping candidate"],
      "tags": ["split-K", "waves-per-block", "rows-per-wave"]
    },
    {
      "id": "vector-load-vgpr",
      "title": "Vector load and VGPR",
      "layer": "KERNEL",
      "availability": "PARTIAL",
      "summary": "Evaluates vector-load width, register use, scratch and occupancy signatures.",
      "inputs": ["ISA", "resource evidence"],
      "outputs": ["load or register patch"],
      "tags": ["VGPR", "occupancy"]
    },
    {
      "id": "gate-up-fusion",
      "title": "Gate + Up fusion",
      "layer": "KERNEL",
      "availability": "PARTIAL",
      "summary": "Tracks fused FFN projections and activation/dequant intermediate traffic.",
      "inputs": ["gate/up execution map", "traffic evidence"],
      "outputs": ["fused kernel"],
      "tags": ["fusion", "FFN"]
    },
    {
      "id": "mfma-mmq-evidence",
      "title": "MFMA / MMQ evidence closure",
      "layer": "KERNEL",
      "availability": "IMPLEMENTED",
      "summary": "Closes actual ISA, wave, resource, stall and shape evidence without claiming an autotuner.",
      "inputs": ["kernel evidence", "code-object ISA"],
      "outputs": ["MatrixPathEvidence"],
      "tags": ["MFMA", "WMMA", "MMQ"]
    },
    {
      "id": "hip-graph-ab",
      "title": "HIP Graph A/B",
      "layer": "RUNTIME",
      "availability": "IMPLEMENTED",
      "summary": "Runs paired same-binary Graph ON/OFF benchmarks and optional trace comparison.",
      "inputs": ["selected model", "same binary", "benchmark protocol"],
      "outputs": ["HipGraphABDecision"],
      "tags": ["launch-overhead"]
    },
    {
      "id": "buffer-memory-audit",
      "title": "Buffer / memory audit",
      "layer": "RUNTIME",
      "availability": "IMPLEMENTED",
      "summary": "Audits allocation, workspace, copy, memset, lifetime and intermediate HBM evidence.",
      "inputs": ["normalized runtime trace"],
      "outputs": ["OPPORTUNITY_FOUND", "NO_ACTION", "INCONCLUSIVE"],
      "tags": ["memory-reuse"]
    },
    {
      "id": "buffer-reuse-patch",
      "title": "Buffer reuse patch",
      "layer": "RUNTIME",
      "availability": "PARTIAL",
      "summary": "Runs at most two evidence-backed reuse patches through before/after gates.",
      "inputs": ["MemoryOpportunity"],
      "outputs": ["MemoryPatchDecision"],
      "tags": ["workspace", "lifetime"]
    },
    {
      "id": "memory-copy-audit",
      "title": "Memcpy / memset audit",
      "layer": "RUNTIME",
      "availability": "IMPLEMENTED",
      "summary": "Separates measured copy and memset cost from unavailable byte evidence.",
      "inputs": ["runtime trace aggregates"],
      "outputs": ["copy opportunity or bound"],
      "tags": ["HBM", "intermediate"]
    },
    {
      "id": "scheduler-audit",
      "title": "Scheduler audit",
      "layer": "RUNTIME",
      "availability": "NOT_IMPLEMENTED",
      "summary": "General HTTP, multi-request and scheduler optimization is outside the current phase.",
      "inputs": ["multi-request trace"],
      "outputs": ["scheduler evidence"],
      "tags": ["future"]
    },
    {
      "id": "target-inspection",
      "title": "Target inspection",
      "layer": "EVIDENCE",
      "availability": "IMPLEMENTED",
      "summary": "Locks model, runtime commit, build, GPU, ROCm and workload identity.",
      "inputs": ["OptimizationTask"],
      "outputs": ["inspection evidence"],
      "tags": ["identity"]
    },
    {
      "id": "shared-baseline",
      "title": "Shared baseline",
      "layer": "EVIDENCE",
      "availability": "IMPLEMENTED",
      "summary": "Captures reusable pp/tg metrics and run identity under fixed coordinates.",
      "inputs": ["inspected target"],
      "outputs": ["BaselineResult"],
      "tags": ["pp512", "tg128", "tg512"]
    },
    {
      "id": "execution-map",
      "title": "Inference execution map",
      "layer": "EVIDENCE",
      "availability": "IMPLEMENTED",
      "summary": "Connects model phase and operator to runtime path, kernel and hardware evidence.",
      "inputs": ["model geometry", "profile evidence"],
      "outputs": ["InferenceExecutionMap"],
      "tags": ["operator-to-kernel"]
    },
    {
      "id": "rocm-kernel-profile",
      "title": "ROCm kernel evidence",
      "layer": "EVIDENCE",
      "availability": "IMPLEMENTED",
      "summary": "Uses ROCm Issue Agent MCP for normalized timing and trace evidence.",
      "inputs": ["approved workload"],
      "outputs": ["kernel timing", "dispatch", "trace artifacts"],
      "tags": ["MCP", "Level-2"]
    },
    {
      "id": "evidence-provider-registry",
      "title": "Evidence provider registry",
      "layer": "EVIDENCE",
      "availability": "IMPLEMENTED",
      "summary": "Separates direct integration, adapters, transitive tools and installed-but-unused capabilities.",
      "inputs": ["provider catalogue", "read-only installation probe"],
      "outputs": ["EvidenceCapabilitySnapshot"],
      "tags": ["ROCm Issue Agent", "Magpie", "TraceLens", "IntelliKit"]
    },
    {
      "id": "kernel-shape-manifest",
      "title": "Shape-aware kernel manifest",
      "layer": "EVIDENCE",
      "availability": "IMPLEMENTED",
      "summary": "Keeps graph variant, launch geometry, quantization and config-attributed M/N/K separate without guessing.",
      "inputs": ["kernel evidence", "operator attribution rules"],
      "outputs": ["KernelShapeManifest"],
      "tags": ["variant-signature", "M/N/K", "coverage"]
    },
    {
      "id": "magpie-evidence-import",
      "title": "Magpie evidence import",
      "layer": "EVIDENCE",
      "availability": "PARTIAL",
      "summary": "Imports hash-bound throughput, latency, completed requests, gap analysis and telemetry reports.",
      "inputs": ["benchmark_report.json"],
      "outputs": ["MagpieBenchmarkEvidence"],
      "tags": ["vLLM", "SGLang", "Atom"]
    },
    {
      "id": "tracelens-evidence-import",
      "title": "TraceLens evidence import",
      "layer": "EVIDENCE",
      "availability": "PARTIAL",
      "summary": "Imports semantic roofline analysis while binding live-measured versus static architecture provenance.",
      "inputs": ["TraceLens compact roofline CSV", "architecture provenance"],
      "outputs": ["TraceLensRooflineEvidence"],
      "tags": ["roofline", "trace-analysis"]
    },
    {
      "id": "intellikit-evidence-import",
      "title": "IntelliKit evidence boundary",
      "layer": "EVIDENCE",
      "availability": "PARTIAL",
      "summary": "Preserves Kerncap, Metrix, Linex, Nexus, Accordo and uProf artifacts without automatically making unknown schemas Gate-eligible.",
      "inputs": ["provider JSON", "tool identity"],
      "outputs": ["IntelliKitEvidenceEnvelope"],
      "tags": ["Kerncap", "Metrix", "Linex", "Nexus", "Accordo"]
    },
    {
      "id": "runtime-health-evidence",
      "title": "Runtime health evidence",
      "layer": "EVIDENCE",
      "availability": "IMPLEMENTED",
      "summary": "Captures disk, shared memory, relevant processes, dependency paths and provider availability without duplicating GPU telemetry.",
      "inputs": ["local host", "task paths"],
      "outputs": ["RuntimeHealthSnapshot"],
      "tags": ["health", "read-only"]
    },
    {
      "id": "isa-resource-evidence",
      "title": "ISA and resource evidence",
      "layer": "EVIDENCE",
      "availability": "PARTIAL",
      "summary": "Uses code-object tools when integrated evidence is unavailable from MCP.",
      "inputs": ["selected kernel", "code object"],
      "outputs": ["ISA", "VGPR", "LDS", "wave size"],
      "tags": ["fallback"]
    },
    {
      "id": "performance-gate",
      "title": "Performance gate",
      "layer": "VALIDATION",
      "availability": "IMPLEMENTED",
      "summary": "Checks stability, comparability, pp/tg improvement and latency before expensive quality.",
      "inputs": ["baseline", "candidate benchmark"],
      "outputs": ["performance decision"],
      "tags": ["CV", "environment"]
    },
    {
      "id": "quality-gate",
      "title": "Quality gate (provisional 100)",
      "layer": "VALIDATION",
      "availability": "PARTIAL",
      "summary": "Checks correctness, PPL and the current provisional stratified 100-question benchmark.",
      "inputs": ["performance-eligible candidate"],
      "outputs": ["quality evidence"],
      "tags": ["PPL", "math-100"]
    },
    {
      "id": "decision-gate",
      "title": "ACCEPT / REJECT / INCONCLUSIVE",
      "layer": "VALIDATION",
      "availability": "IMPLEMENTED",
      "summary": "Combines deterministic performance, correctness, quality and environment gates.",
      "inputs": ["performance", "quality", "evidence completeness"],
      "outputs": ["GateDecision"],
      "tags": ["deterministic"]
    },
    {
      "id": "experiment-store",
      "title": "Experiment store",
      "layer": "VALIDATION",
      "availability": "IMPLEMENTED",
      "summary": "Persists immutable artifacts, hashes, events, attempts and experiment provenance.",
      "inputs": ["all workflow evidence"],
      "outputs": ["auditable experiment history"],
      "tags": ["SHA-256", "append-only"]
    },
    {
      "id": "gfx1201-final-report",
      "title": "gfx1201 final report",
      "layer": "VALIDATION",
      "availability": "IMPLEMENTED",
      "summary": "Links model, kernel and runtime capability conclusions to verified artifacts.",
      "inputs": ["closed capability results"],
      "outputs": ["JSON report", "Markdown report"],
      "tags": ["phase-closure"]
    }
  ],
  "edges": [
