+template <int split_waves>
+__global__ __launch_bounds__(Q4RDNA_THREADS) void q4rdna_gemv_split_k_gate_q3(
+        const uint8_t * up_weights, const uint8_t * gate_weights,
+        const float * activation, float * output, int columns) {
+    static_assert(split_waves == 8, "Q3 gate experiment requires split8");
+    constexpr int tiles_per_block = Q4RDNA_WARPS / split_waves;
+    __shared__ float up_shared[Q4RDNA_WARPS][Q4RDNA_TILE_ROWS];
+    __shared__ float gate_shared[Q4RDNA_WARPS][Q4RDNA_TILE_ROWS];
+    const int lane = threadIdx.x & (Q4RDNA_TILE_ROWS - 1);
+    const int warp = threadIdx.x / Q4RDNA_TILE_ROWS;
+    const int split = warp & (split_waves - 1);
+    const int tile_in_block = warp / split_waves;
+    const int row_tile = blockIdx.x * tiles_per_block + tile_in_block;
+    const int groups = columns / Q4RDNA_GROUP;
+    float up_sum = 0.0f;
+    float gate_sum = 0.0f;
+
+    for (int group = split; group < groups; group += split_waves) {
+        const uint8_t * up_tile =
+            up_weights + uint64_t(row_tile * groups + group) * Q4RDNA_TILE_BYTES;
+        const uint8_t * gate_tile =
+            gate_weights + uint64_t(row_tile * groups + group) * Q3RDNA_TILE_BYTES;
+        float up_low = 0.0f;
+        float up_high = 0.0f;
+        float gate_partial = 0.0f;
+#pragma unroll
+        for (int chunk = 0; chunk < 8; ++chunk) {
+#pragma unroll
+            for (int pair = 0; pair < 4; ++pair) {
+                const int index = chunk * 4 + pair;
+                const float activation_low = activation[group * Q4RDNA_GROUP + 2 * index];
+                const float activation_high = activation[group * Q4RDNA_GROUP + 2 * index + 1];
+                const uint8_t packed = up_tile[64 + index * Q4RDNA_TILE_ROWS + lane];
+                up_low = fmaf(float(q4rdna_low(packed)), activation_low, up_low);
+                up_high = fmaf(float(q4rdna_high(packed)), activation_high, up_high);
+            }
+            const uint32_t gate_packed =
+                uint32_t(gate_tile[64 + (chunk * 3 + 0) * Q4RDNA_TILE_ROWS + lane]) |
+                uint32_t(gate_tile[64 + (chunk * 3 + 1) * Q4RDNA_TILE_ROWS + lane]) << 8 |
+                uint32_t(gate_tile[64 + (chunk * 3 + 2) * Q4RDNA_TILE_ROWS + lane]) << 16;
+#pragma unroll
+            for (int value = 0; value < 8; ++value) {
+                gate_partial = fmaf(
+                    float(q3rdna_decode(gate_packed >> (3 * value))),
+                    activation[group * Q4RDNA_GROUP + chunk * 8 + value],
+                    gate_partial);
+            }
+        }
+        const float up_scale =
+            __half2float(reinterpret_cast<const half *>(up_tile)[lane]);
+        const float gate_scale =
+            __half2float(reinterpret_cast<const half *>(gate_tile)[lane]);
+        up_sum = fmaf(up_scale, up_low + up_high, up_sum);
+        gate_sum = fmaf(gate_scale, gate_partial, gate_sum);
+    }
+
+    up_shared[warp][lane] = up_sum;
+    gate_shared[warp][lane] = gate_sum;
+    __syncthreads();
+    if (split == 0) {
+#pragma unroll
+        for (int other = 1; other < split_waves; ++other) {
+            up_sum += up_shared[warp + other][lane];
+            gate_sum += gate_shared[warp + other][lane];
+        }
+        output[row_tile * Q4RDNA_TILE_ROWS + lane] =
+            up_sum * ggml_cuda_op_silu_single(gate_sum);
+    }
+}
